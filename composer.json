{
    "name": "ahliweb/sibaja",
    "description": "SIBAJA - Sistem Informasi Barang dan Jasa",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpspreadsheet": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php spark phpini:check"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
